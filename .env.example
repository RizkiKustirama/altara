# ==============================================================================
# ALTARA WEDDING ORGANIZER - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Database Connection (PostgreSQL single-tenant instance)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/altara_wo"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth Session Secret (Minimum 32 random characters)
AUTH_SECRET="change-this-to-a-secure-random-32-character-secret"

# Node Environment
NODE_ENV="development"
